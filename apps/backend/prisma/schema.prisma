// =============================================
// ePerencanaan - Schema Lengkap
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StatusProyek {
  DRAFT
  APPROVED
}

enum MasaPelaksanaan {
  SINGLE_YEAR
  MULTI_YEAR
}

enum Kewenangan {
  PUSAT
  DAERAH
}

enum AllokasiStatus {
  RENCANA
  REALISASI
}

enum TipeKoordinat {
  TITIK
  GARIS
  POLIGON
}

enum JenisPaket {
  FISIK
  NON_FISIK
}

enum SumberUsulanProyek {
  PEMERINTAH_DAERAH
  KEMENTERIAN_LEMBAGA
  MASYARAKAT
  TINDAK_LANJUT_RENAKSI
  LAINNYA
}

// =============================================
// MASTER: Auth & User
// =============================================

model Role {
  id          String  @id @default(cuid())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  // Cakupan kegiatan role ini (mis. "7691"). Diisi = role cuma boleh
  // melihat/mengelola proyek yang paketnya ada di kegiatan tsb. Kosong =
  // lintas kegiatan, dan itu HANYA sah untuk SUPER_ADMIN & ADMINISTRATOR
  // (lihat kegiatanScopeOf() di plannings.service.ts).
  kegiatanId String?   @db.VarChar(10)
  kegiatan   Kegiatan? @relation(fields: [kegiatanId], references: [id])

  // Template izin yang dipinjam role ini (lihat src/auth/role.ts). Kosong =
  // izinnya dicocokkan dari `code` sendiri. Tanpa ini, role baru dari UI
  // ditolak semua @Roles() karena kodenya tidak ada di daftar dekorator.
  baseRole String? @db.VarChar(50)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String  @id @default(cuid())
  email        String? @db.VarChar(200)
  username     String  @unique @db.VarChar(50)
  passwordHash String  @db.VarChar(255)
  name         String  @db.VarChar(150)
  nip          String? @db.VarChar(30)
  phone        String? @db.VarChar(20)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  deletedAt   DateTime?

  balaiId Int?
  balai   Balai? @relation(fields: [balaiId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proyek           Proyek[]
  activityLogs     ActivityLog[]
  dokumenPendukung DokumenPendukung[]

  @@map("users")
}

// =============================================
// MASTER: Wilayah & Organisasi
// =============================================

model Balai {
  id        Int     @id
  name      String  @db.VarChar(150)
  shortName String? @db.VarChar(100)
  code      String? @unique @db.VarChar(10)
  // Kalau false, SATKER balai ini tidak bisa membuat paket baru (dicek oleh
  // ADMINISTRATOR di master data Balai). ADMINISTRATOR sendiri tidak terkena
  // batasan ini.
  isActive  Boolean @default(true)

  latitude  Float?
  longitude Float?

  provinceId String? @db.VarChar(10)
  cityId     String? @db.VarChar(10)

  users  User[]
  proyek Proyek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("balai")
}

model Periode {
  id        Int     @id @default(autoincrement())
  startYear Int     @db.SmallInt
  endYear   Int     @db.SmallInt
  label     String  @db.VarChar(20)
  isActive  Boolean @default(false)

  proyek Proyek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("periodes")
}

// =============================================
// MASTER: Nomenklatur (Program > Kegiatan > KRO > RO)
// =============================================

model Program {
  id   String @id @db.VarChar(10)
  name String @db.VarChar(255)
  code String @db.VarChar(10)

  kegiatan       Kegiatan[]
  sasaranProgram SasaranProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("programs")
}

model Kegiatan {
  id        String  @id @db.VarChar(10)
  programId String  @db.VarChar(10)
  program   Program @relation(fields: [programId], references: [id])
  name      String  @db.VarChar(255)
  code      String  @db.VarChar(10)

  kroList         KRO[]
  sasaranKegiatan SasaranKegiatan[]
  roles           Role[]
  evaluasiItem    EvaluasiItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kegiatan")
}

model KRO {
  id         String   @id @db.VarChar(20)
  kegiatanId String   @db.VarChar(10)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])
  name       String   @db.VarChar(255)
  code       String   @db.VarChar(10)

  roList RO[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kro")
}

model RO {
  id     String  @id @db.VarChar(20)
  kroId  String  @db.VarChar(20)
  kro    KRO     @relation(fields: [kroId], references: [id])
  name   String  @db.VarChar(255)
  code   String  @db.VarChar(10)
  // Satuan resmi RO (kolom "Satuan RO" di referensi 1.xlsx, mis. "Unit",
  // "Km", "Dokumen") — dipakai untuk mengunci field Satuan Output Target
  // pada Alokasi, bukan input teks bebas. Dari master Satuan (dropdown),
  // bukan text bebas, supaya format konsisten antar RO.
  satuanId String?
  satuan   Satuan? @relation(fields: [satuanId], references: [id])

  indikatorRO IndikatorRO[]
  paket       Paket[]
  komponen    Komponen[]
  provinsi    RoProvinsi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ro")
}

/// Provinsi cakupan RO — 1 RO bisa mencakup banyak provinsi.
model RoProvinsi {
  id           String @id @default(cuid())
  roId         String @db.VarChar(20)
  ro           RO     @relation(fields: [roId], references: [id], onDelete: Cascade)
  provinceId   String @db.VarChar(10)
  provinceName String @db.VarChar(100)

  @@unique([roId, provinceId])
  @@map("ro_provinsi")
}

// =============================================
// MASTER: Satuan (dropdown, dipakai RO/Komponen/Indikator RO)
// =============================================

model Satuan {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(50)

  ro          RO[]
  komponen    Komponen[]
  indikatorRo IndikatorRoSatuan[]

  createdAt DateTime @default(now())

  @@map("satuan")
}

// =============================================
// MASTER: Komponen (anak dari RO)
// =============================================

model Komponen {
  id       String  @id @default(cuid())
  roId     String  @db.VarChar(20)
  ro       RO      @relation(fields: [roId], references: [id])
  code     String  @db.VarChar(10)
  name     String  @db.VarChar(255)
  satuanId String?
  satuan   Satuan? @relation(fields: [satuanId], references: [id])

  paket Paket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roId])
  @@map("komponen")
}

model IndikatorRO {
  id   String @id @default(cuid())
  roId String @db.VarChar(20)
  ro   RO     @relation(fields: [roId], references: [id])
  nama String @db.VarChar(255)

  satuanList IndikatorRoSatuan[]
  paket      Paket[]

  @@map("indikator_ro")
}

/// Join table: 1 Indikator RO bisa punya banyak satuan.
model IndikatorRoSatuan {
  id            String      @id @default(cuid())
  indikatorRoId String
  indikatorRo   IndikatorRO @relation(fields: [indikatorRoId], references: [id], onDelete: Cascade)
  satuanId      String
  satuan        Satuan      @relation(fields: [satuanId], references: [id])

  @@unique([indikatorRoId, satuanId])
  @@map("indikator_ro_satuan")
}

// =============================================
// MASTER: Prioritas Nasional (RPJMN) — PN > PP > KP
// =============================================

model PrioritasNasional {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(10)
  name String @db.Text

  programPrioritas ProgramPrioritas[]

  @@map("prioritas_nasional")
}

model ProgramPrioritas {
  id                  String            @id @default(cuid())
  prioritasNasionalId String
  prioritasNasional   PrioritasNasional @relation(fields: [prioritasNasionalId], references: [id])
  code                String            @unique @db.VarChar(10)
  name                String            @db.VarChar(255)

  kegiatanPrioritas KegiatanPrioritas[]

  @@index([prioritasNasionalId])
  @@map("program_prioritas")
}

model KegiatanPrioritas {
  id                 String           @id @default(cuid())
  programPrioritasId String
  programPrioritas   ProgramPrioritas @relation(fields: [programPrioritasId], references: [id])
  code               String           @unique @db.VarChar(15)
  name               String           @db.VarChar(255)

  proyek Proyek[]

  @@index([programPrioritasId])
  @@map("kegiatan_prioritas")
}

// =============================================
// MASTER: PKPN & Tematik RENJA (daftar flat, berubah tiap siklus RENJA)
// =============================================

model Pkpn {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(255)

  proyek Proyek[]

  @@map("pkpn")
}

model TematikRenja {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(100)

  proyek Proyek[]

  @@map("tematik_renja")
}

// =============================================
// MASTER: Sasaran Program/Kegiatan — SP/ISP (anak Program), SK/ISK (anak Kegiatan)
// =============================================

model SasaranProgram {
  id        String  @id @default(cuid())
  programId String  @db.VarChar(10)
  program   Program @relation(fields: [programId], references: [id])
  name      String  @db.Text

  indikator IndikatorSasaranProgram[]

  @@index([programId])
  @@map("sasaran_program")
}

model IndikatorSasaranProgram {
  id               String         @id @default(cuid())
  sasaranProgramId String
  sasaranProgram   SasaranProgram @relation(fields: [sasaranProgramId], references: [id])
  name             String         @db.Text
  satuan           String?        @db.VarChar(50)

  proyek Proyek[]

  @@index([sasaranProgramId])
  @@map("indikator_sasaran_program")
}

model SasaranKegiatan {
  id         String   @id @default(cuid())
  kegiatanId String   @db.VarChar(10)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])
  name       String   @db.Text

  indikator IndikatorSasaranKegiatan[]

  @@index([kegiatanId])
  @@map("sasaran_kegiatan")
}

model IndikatorSasaranKegiatan {
  id                String          @id @default(cuid())
  sasaranKegiatanId String
  sasaranKegiatan   SasaranKegiatan @relation(fields: [sasaranKegiatanId], references: [id])
  name              String          @db.Text
  satuan            String?         @db.VarChar(50)

  proyek Proyek[]

  @@index([sasaranKegiatanId])
  @@map("indikator_sasaran_kegiatan")
}

// =============================================
// MASTER: Evaluasi (Multi Criteria Analysis)
// =============================================
// Sumber: referensi 1.xlsx sheet "evaluasi Irwa/supan/benda/atab". Metode
// (dulu enum tetap Urgensitas/Kesiapan Teknis/Tematik/Valuasi, bobot
// 40/20/20/20 hardcoded) sekarang jadi master data juga, supaya bobotnya
// bisa diubah admin tanpa ubah kode. Poin/item per metode tetap beda per
// kegiatan. Bobot per item = score / total score metode * bobot metode
// (lihat hitungSkorEvaluasi()).

model MetodeEvaluasi {
  id     String @id @default(cuid())
  name   String @db.VarChar(150)
  // Bobot metode ini terhadap skor total, 0..1 (mis. 0.4 = 40%). Tidak
  // divalidasi harus total 1 di semua metode — itu urusan admin saat
  // mengisi, biar fleksibel kalau metode ditambah/dihapus.
  bobot  Float
  urutan Int    @default(0) @db.SmallInt

  item EvaluasiItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("metode_evaluasi")
}

model EvaluasiItem {
  id         String   @id @default(cuid())
  kegiatanId String   @db.VarChar(10)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])

  metodeId String
  metode   MetodeEvaluasi @relation(fields: [metodeId], references: [id])

  name  String @db.Text
  // Bobot mentah item ini di dalam metodenya (kolom "Score" di excel).
  score Int    @default(1) @db.SmallInt

  proyek ProyekEvaluasi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kegiatanId, metodeId])
  @@map("evaluasi_item")
}

model ProyekEvaluasi {
  proyekId String
  proyek   Proyek @relation(fields: [proyekId], references: [id], onDelete: Cascade)

  itemId String
  item   EvaluasiItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  keterangan String? @db.Text

  @@id([proyekId, itemId])
  @@index([itemId])
  @@map("proyek_evaluasi")
}

// =============================================
// MASTER: Wilayah Sungai
// =============================================

model WilayahSungai {
  id   String  @id @default(cuid())
  name String  @db.VarChar(255)
  // Kode WS resmi (kolom "Kd_WS" di referensi master, mis. "01.01.A3").
  code String? @unique @db.VarChar(20)

  proyek Proyek[]

  @@map("wilayah_sungai")
}

// =============================================
// WILAYAH ADMINISTRATIF (di-host lokal)
// =============================================
// Sebelumnya di-proxy live dari emsifa.com saat runtime — rentan terhadap
// masalah TLS/DNS pihak ketiga (lihat "Update — Perbaikan Fitur Reverse
// Geocode Otomatis" di dokumen analisis). Solusi jangka panjang: import
// sekali ke tabel-tabel ini (lihat `prisma/scripts/import-wilayah.ts`),
// setelah itu WilayahService membaca dari sini, bukan dari internet.
// ID memakai kode resmi Kemendagri (String) sesuai emsifa.com, BUKAN
// auto-increment/cuid, supaya konsisten dengan field provinceId/cityId/dst.
// yang sudah dipakai di Balai/Planning/LokasiAlokasi (String @db.VarChar(10)).

model WilayahProvince {
  id            String  @id @db.VarChar(10)
  name          String  @db.VarChar(150)
  // Kode di file referensi master Kementerian (BEDA skema dari kode
  // Kemendagri/emsifa di atas — jangan disamakan). Cuma dipakai sebagai
  // kunci pencocokan kalau file referensi ini disinkronkan ulang di masa
  // depan, TIDAK dipakai oleh reverse-geocode/dropdown wilayah.
  kodeReferensi String? @unique @db.VarChar(10)

  regencies WilayahRegency[]

  @@map("wilayah_provinces")
}

model WilayahRegency {
  id            String  @id @db.VarChar(10)
  name          String  @db.VarChar(150)
  provinceId    String  @db.VarChar(10)
  // lihat komentar kodeReferensi di WilayahProvince
  kodeReferensi String? @unique @db.VarChar(10)

  province  WilayahProvince   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts WilayahDistrict[]

  @@index([provinceId])
  @@map("wilayah_regencies")
}

model WilayahDistrict {
  id            String  @id @db.VarChar(10)
  name          String  @db.VarChar(150)
  regencyId     String  @db.VarChar(10)
  // lihat komentar kodeReferensi di WilayahProvince
  kodeReferensi String? @unique @db.VarChar(10)

  regency  WilayahRegency   @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  villages WilayahVillage[]

  @@index([regencyId])
  @@map("wilayah_districts")
}

model WilayahVillage {
  id         String @id @db.VarChar(10)
  name       String @db.VarChar(150)
  districtId String @db.VarChar(10)

  district WilayahDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
  @@map("wilayah_villages")
}

// =============================================
// LOG AKTIVITAS
// =============================================
// Diisi otomatis oleh ActivityLogInterceptor untuk setiap mutasi
// (POST/PATCH/PUT/DELETE) yang sukses. Dibaca HANYA oleh SUPER_ADMIN.

model ActivityLog {
  id String @id @default(cuid())

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  username String  @db.VarChar(50)
  roleCode String? @db.VarChar(50)

  method     String  @db.VarChar(10)
  path       String  @db.VarChar(255)
  entity     String? @db.VarChar(50)
  entityId   String? @db.VarChar(60)
  statusCode Int     @db.SmallInt
  ip         String? @db.VarChar(45)
  // Ringkasan payload (tanpa password/token) — untuk menjawab "apa yang diubah".
  meta       Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================
// PROYEK UTAMA
// =============================================

model Proyek {
  id String @id @default(cuid())

  balaiId Int
  balai   Balai @relation(fields: [balaiId], references: [id])

  periodeId Int
  periode   Periode @relation(fields: [periodeId], references: [id])

  kodeProyek  String?    @unique @db.VarChar(50)
  projectName String     @db.Text
  kewenangan  Kewenangan @default(PUSAT)

  provinceId String? @db.VarChar(10)
  cityId     String? @db.VarChar(10)
  latitude   Float?
  longitude  Float?

  // Kesesuaian proyek cuma dua hal: wilayah sungai & kebutuhan tanah.
  // Kolom RTRW/Pola SDA/Masterplan dibuang — tidak dipakai di form.
  kebutuhanTanah Boolean @default(false)

  wilayahSungaiId String?
  wilayahSungai   WilayahSungai? @relation(fields: [wilayahSungaiId], references: [id])

  // Dasar pelaksanaan — tab "Dasar Pelaksanaan".
  sumberUsulanProyek  SumberUsulanProyek?
  sumberUsulanLainnya String?             @db.Text
  justifikasiProyek   String?             @db.Text

  // StudiLayak/DED/LARAP di DB.xlsx cuma angka tahun polos, tanpa status
  // terpisah — jadi field langsung, bukan lewat KriteriaDokumen generic
  // (dibuang, lihat docs-planning/audit-restrukturisasi-db-xlsx.md §3.3).
  tahunStudiLayak        Int? @db.SmallInt
  tahunDed               Int? @db.SmallInt
  tahunLarap             Int? @db.SmallInt
  tahunDokumenLingkungan Int? @db.SmallInt

  // === TAGGING === pindah dari Paket ke sini (1 proyek = 1 set tagging,
  // bukan per paket — lihat plan "Rombak Modal Proyek jadi 7 Tab").
  kegiatanPrioritasId String? // RPJMN: PN.PP.KP, 1 proyek = 1 KP
  kegiatanPrioritas   KegiatanPrioritas? @relation(fields: [kegiatanPrioritasId], references: [id])

  pkpnId String? // RENJA: PKPN
  pkpn   Pkpn?   @relation(fields: [pkpnId], references: [id])

  indikatorSasaranProgramId String? // RENSTRA: SP/ISP
  indikatorSasaranProgram   IndikatorSasaranProgram? @relation(fields: [indikatorSasaranProgramId], references: [id])

  indikatorSasaranKegiatanId String? // RENSTRA: SK/ISK
  indikatorSasaranKegiatan   IndikatorSasaranKegiatan? @relation(fields: [indikatorSasaranKegiatanId], references: [id])

  tematikRenjaId String? // RENJA: Tematik
  tematikRenja   TematikRenja? @relation(fields: [tematikRenjaId], references: [id])

  fkb Boolean @default(false)
  fkw Boolean @default(false)
  mpa Boolean @default(false)

  // Tagging Dinamis — daftar tag bebas, ditulis manual.
  taggingDinamis String[] @default([])

  // === DOKUMEN & CATATAN ===
  catatanPembina String? @db.Text
  catatanSspsda  String? @db.Text

  status  StatusProyek @default(DRAFT)
  catatan String?      @db.Text

  // Hasil evaluasi MCA — 0..1, dihitung ulang otomatis dari deteksi
  // tagging/kriteria teknis tiap kali proyek disimpan (jangan diisi manual
  // dari client, lihat src/proyek/evaluasi-deteksi.ts).
  skorEvaluasi Decimal? @db.Decimal(6, 4)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  paket            Paket[]
  evaluasi         ProyekEvaluasi[]
  dokumenPendukung DokumenPendukung[]

  @@index([balaiId])
  @@index([status])
  @@index([createdById])
  @@index([periodeId])
  @@map("proyek")
}

model DokumenPendukung {
  id       String @id @default(cuid())
  proyekId String
  proyek   Proyek @relation(fields: [proyekId], references: [id], onDelete: Cascade)

  fileName String @db.VarChar(255) // nama asli file
  filePath String @db.VarChar(500) // path relatif di disk (mis. "proyek/<id>/<uuid>.pdf")
  mimeType String @db.VarChar(100)
  size     Int

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([proyekId])
  @@map("dokumen_pendukung")
}

// =============================================
// PAKET
// =============================================

model Paket {
  id       String @id @default(cuid())
  proyekId String
  proyek   Proyek @relation(fields: [proyekId], references: [id], onDelete: Cascade)

  kodePaket String? @unique @db.VarChar(50)
  name      String  @db.VarChar(255)

  roId String @db.VarChar(20)
  ro   RO     @relation(fields: [roId], references: [id])

  komponenId String?
  komponen   Komponen? @relation(fields: [komponenId], references: [id])

  jenis           JenisPaket
  masaPelaksanaan MasaPelaksanaan

  dokLingStatus String? @db.VarChar(50)

  // indikatorRoId tetap di sini (bukan pindah ke Proyek) — RO/indikatornya
  // spesifik per paket, beda paket bisa beda RO.
  indikatorRoId String?
  indikatorRo   IndikatorRO? @relation(fields: [indikatorRoId], references: [id])

  // Untuk ranking prioritas antar paket — algoritma penilaian menyusul,
  // sengaja nullable & tidak diisi lewat form dulu.
  score Decimal? @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  alokasi Alokasi[]

  @@index([proyekId])
  @@index([roId])
  @@map("paket")
}

// =============================================
// ALOKASI
// =============================================

model Alokasi {
  id      String @id @default(cuid())
  paketId String
  paket   Paket  @relation(fields: [paketId], references: [id], onDelete: Cascade)

  tahun  Int            @db.SmallInt
  status AllokasiStatus

  rm    Decimal @default(0) @db.Decimal(16, 0)
  rmp   Decimal @default(0) @db.Decimal(16, 0)
  pln   Decimal @default(0) @db.Decimal(16, 0)
  sbsn  Decimal @default(0) @db.Decimal(16, 0)
  kpbu  Decimal @default(0) @db.Decimal(16, 0)
  total Decimal @default(0) @db.Decimal(16, 0)

  outputTarget  Decimal? @db.Decimal(10, 4)
  outputUnit    String?  @db.VarChar(50)
  outcomeTarget Decimal? @db.Decimal(10, 4)
  outcomeUnit   String?  @db.VarChar(50)

  catatan String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lokasi         LokasiAlokasi[]
  historiAlokasi HistoriAlokasi[]

  @@unique([paketId, tahun, status])
  @@index([tahun])
  @@map("alokasi")
}

model LokasiAlokasi {
  id        String  @id @default(cuid())
  alokasiId String
  alokasi   Alokasi @relation(fields: [alokasiId], references: [id], onDelete: Cascade)

  name          String?       @db.VarChar(255)
  tipeKoordinat TipeKoordinat @default(TITIK)

  // Wilayah administratif
  provinceId   String? @db.VarChar(10)
  provinceName String? @db.VarChar(100)
  cityId       String? @db.VarChar(10)
  cityName     String? @db.VarChar(100)
  districtId   String? @db.VarChar(10)
  districtName String? @db.VarChar(100)
  villageId    String? @db.VarChar(10)
  villageName  String? @db.VarChar(100)

  // Koordinat: untuk TITIK pakai latitude/longitude, untuk GARIS/POLIGON pakai coordinates (JSON array of [lat,lng])
  latitude    Float?
  longitude   Float?
  coordinates Json? // [[lat, lng], [lat, lng], ...] untuk garis/poligon

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lokasi_alokasi")
}

model HistoriAlokasi {
  id        String  @id @default(cuid())
  alokasiId String
  alokasi   Alokasi @relation(fields: [alokasiId], references: [id], onDelete: Cascade)

  rm            Decimal  @db.Decimal(16, 0)
  rmp           Decimal  @db.Decimal(16, 0)
  pln           Decimal  @db.Decimal(16, 0)
  sbsn          Decimal  @db.Decimal(16, 0)
  kpbu          Decimal  @db.Decimal(16, 0)
  total         Decimal  @db.Decimal(16, 0)
  outputTarget  Decimal? @db.Decimal(10, 4)
  outcomeTarget Decimal? @db.Decimal(10, 4)
  catatan       String?  @db.Text

  changedAt DateTime @default(now())
  changedBy String   @db.VarChar(150)

  @@map("histori_alokasi")
}
