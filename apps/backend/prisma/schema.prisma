// =============================================
// ePerencanaan - Schema Lengkap
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PlanningStatus {
  DRAFT
  APPROVED
}

enum MasaPelaksanaan {
  SINGLE_YEAR
  MULTI_YEAR
}

enum Kewenangan {
  PUSAT
  DAERAH
}

enum AllokasiStatus {
  RENCANA
  REALISASI
}

enum TipeKoordinat {
  TITIK
  GARIS
  POLIGON
}

enum JenisPaket {
  FISIK
  NON_FISIK
}

enum SumberUsulanProyek {
  PEMERINTAH_DAERAH
  KEMENTERIAN_LEMBAGA
  MASYARAKAT
  TINDAK_LANJUT_RENAKSI
  LAINNYA
}

// =============================================
// MASTER: Auth & User
// =============================================

model Role {
  id          String  @id @default(cuid())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String  @id @default(cuid())
  email        String? @db.VarChar(200)
  username     String  @unique @db.VarChar(50)
  passwordHash String  @db.VarChar(255)
  name         String  @db.VarChar(150)
  nip          String? @db.VarChar(30)
  phone        String? @db.VarChar(20)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  deletedAt   DateTime?

  balaiId Int?
  balai   Balai? @relation(fields: [balaiId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plannings Planning[]

  @@map("users")
}

// =============================================
// MASTER: Wilayah & Organisasi
// =============================================

model Balai {
  id        Int     @id
  name      String  @db.VarChar(150)
  shortName String? @db.VarChar(100)
  code      String? @unique @db.VarChar(10)

  latitude  Float?
  longitude Float?

  provinceId String? @db.VarChar(10)
  cityId     String? @db.VarChar(10)

  users     User[]
  plannings Planning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("balai")
}

model Periode {
  id        Int     @id @default(autoincrement())
  startYear Int     @db.SmallInt
  endYear   Int     @db.SmallInt
  label     String  @db.VarChar(20)
  isActive  Boolean @default(false)

  plannings Planning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("periodes")
}

// =============================================
// MASTER: Nomenklatur (Program > Kegiatan > KRO > RO)
// =============================================

model Program {
  id   String @id @db.VarChar(10)
  name String @db.VarChar(255)
  code String @db.VarChar(10)

  kegiatan       Kegiatan[]
  sasaranProgram SasaranProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("programs")
}

model Kegiatan {
  id        String  @id @db.VarChar(10)
  programId String  @db.VarChar(10)
  program   Program @relation(fields: [programId], references: [id])
  name      String  @db.VarChar(255)
  code      String  @db.VarChar(10)

  kroList         KRO[]
  sasaranKegiatan SasaranKegiatan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kegiatan")
}

model KRO {
  id         String   @id @db.VarChar(20)
  kegiatanId String   @db.VarChar(10)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])
  name       String   @db.VarChar(255)
  code       String   @db.VarChar(10)

  roList RO[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kro")
}

model RO {
  id     String  @id @db.VarChar(20)
  kroId  String  @db.VarChar(20)
  kro    KRO     @relation(fields: [kroId], references: [id])
  name   String  @db.VarChar(255)
  code   String  @db.VarChar(10)
  // Satuan resmi RO (kolom "Satuan RO" di referensi 1.xlsx, mis. "Unit",
  // "Km", "Dokumen") — dipakai untuk mengunci field Satuan Output Target
  // pada Alokasi, bukan input teks bebas.
  satuan String? @db.VarChar(50)

  indikatorRO IndikatorRO[]
  paket       Paket[]
  komponen    Komponen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ro")
}

// =============================================
// MASTER: Komponen (anak dari RO)
// =============================================

model Komponen {
  id   String @id @default(cuid())
  roId String @db.VarChar(20)
  ro   RO     @relation(fields: [roId], references: [id])
  code String @db.VarChar(10)
  name String @db.VarChar(255)

  paket Paket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roId])
  @@map("komponen")
}

model IndikatorRO {
  id     String @id @default(cuid())
  roId   String @db.VarChar(20)
  ro     RO     @relation(fields: [roId], references: [id])
  nama   String @db.VarChar(255)
  satuan String @db.VarChar(50)

  paket Paket[]

  @@map("indikator_ro")
}

// =============================================
// MASTER: Prioritas Nasional (RPJMN) — PN > PP > KP
// =============================================

model PrioritasNasional {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(10)
  name String @db.Text

  programPrioritas ProgramPrioritas[]

  @@map("prioritas_nasional")
}

model ProgramPrioritas {
  id                  String            @id @default(cuid())
  prioritasNasionalId String
  prioritasNasional   PrioritasNasional @relation(fields: [prioritasNasionalId], references: [id])
  code                String            @unique @db.VarChar(10)
  name                String            @db.VarChar(255)

  kegiatanPrioritas KegiatanPrioritas[]

  @@index([prioritasNasionalId])
  @@map("program_prioritas")
}

model KegiatanPrioritas {
  id                 String           @id @default(cuid())
  programPrioritasId String
  programPrioritas   ProgramPrioritas @relation(fields: [programPrioritasId], references: [id])
  code               String           @unique @db.VarChar(15)
  name               String           @db.VarChar(255)

  paket Paket[]

  @@index([programPrioritasId])
  @@map("kegiatan_prioritas")
}

// =============================================
// MASTER: PKPN & Tematik RENJA (daftar flat, berubah tiap siklus RENJA)
// =============================================

model Pkpn {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(255)

  paket Paket[]

  @@map("pkpn")
}

model TematikRenja {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(100)

  paket Paket[]

  @@map("tematik_renja")
}

// =============================================
// MASTER: Sasaran Program/Kegiatan — SP/ISP (anak Program), SK/ISK (anak Kegiatan)
// =============================================

model SasaranProgram {
  id        String  @id @default(cuid())
  programId String  @db.VarChar(10)
  program   Program @relation(fields: [programId], references: [id])
  name      String  @db.Text

  indikator IndikatorSasaranProgram[]

  @@index([programId])
  @@map("sasaran_program")
}

model IndikatorSasaranProgram {
  id               String         @id @default(cuid())
  sasaranProgramId String
  sasaranProgram   SasaranProgram @relation(fields: [sasaranProgramId], references: [id])
  name             String         @db.Text
  satuan           String?        @db.VarChar(50)

  paket Paket[]

  @@index([sasaranProgramId])
  @@map("indikator_sasaran_program")
}

model SasaranKegiatan {
  id         String   @id @default(cuid())
  kegiatanId String   @db.VarChar(10)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])
  name       String   @db.Text

  indikator IndikatorSasaranKegiatan[]

  @@index([kegiatanId])
  @@map("sasaran_kegiatan")
}

model IndikatorSasaranKegiatan {
  id                String          @id @default(cuid())
  sasaranKegiatanId String
  sasaranKegiatan   SasaranKegiatan @relation(fields: [sasaranKegiatanId], references: [id])
  name              String          @db.Text
  satuan            String?         @db.VarChar(50)

  paket Paket[]

  @@index([sasaranKegiatanId])
  @@map("indikator_sasaran_kegiatan")
}

// =============================================
// MASTER: Wilayah Sungai
// =============================================

model WilayahSungai {
  id   String  @id @default(cuid())
  name String  @db.VarChar(255)
  // Kode WS resmi (kolom "Kd_WS" di referensi master, mis. "01.01.A3").
  code String? @unique @db.VarChar(20)

  paket Paket[]

  @@map("wilayah_sungai")
}

// =============================================
// WILAYAH ADMINISTRATIF (di-host lokal)
// =============================================
// Sebelumnya di-proxy live dari emsifa.com saat runtime — rentan terhadap
// masalah TLS/DNS pihak ketiga (lihat "Update — Perbaikan Fitur Reverse
// Geocode Otomatis" di dokumen analisis). Solusi jangka panjang: import
// sekali ke tabel-tabel ini (lihat `prisma/scripts/import-wilayah.ts`),
// setelah itu WilayahService membaca dari sini, bukan dari internet.
// ID memakai kode resmi Kemendagri (String) sesuai emsifa.com, BUKAN
// auto-increment/cuid, supaya konsisten dengan field provinceId/cityId/dst.
// yang sudah dipakai di Balai/Planning/LokasiAlokasi (String @db.VarChar(10)).

model WilayahProvince {
  id   String @id @db.VarChar(10)
  name String @db.VarChar(150)
  // Kode di file referensi master Kementerian (BEDA skema dari kode
  // Kemendagri/emsifa di atas — jangan disamakan). Cuma dipakai sebagai
  // kunci pencocokan kalau file referensi ini disinkronkan ulang di masa
  // depan, TIDAK dipakai oleh reverse-geocode/dropdown wilayah.
  kodeReferensi String? @unique @db.VarChar(10)

  regencies WilayahRegency[]

  @@map("wilayah_provinces")
}

model WilayahRegency {
  id         String @id @db.VarChar(10)
  name       String @db.VarChar(150)
  provinceId String @db.VarChar(10)
  // lihat komentar kodeReferensi di WilayahProvince
  kodeReferensi String? @unique @db.VarChar(10)

  province  WilayahProvince   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts WilayahDistrict[]

  @@index([provinceId])
  @@map("wilayah_regencies")
}

model WilayahDistrict {
  id        String @id @db.VarChar(10)
  name      String @db.VarChar(150)
  regencyId String @db.VarChar(10)
  // lihat komentar kodeReferensi di WilayahProvince
  kodeReferensi String? @unique @db.VarChar(10)

  regency  WilayahRegency   @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  villages WilayahVillage[]

  @@index([regencyId])
  @@map("wilayah_districts")
}

model WilayahVillage {
  id         String @id @db.VarChar(10)
  name       String @db.VarChar(150)
  districtId String @db.VarChar(10)

  district WilayahDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
  @@map("wilayah_villages")
}

// =============================================
// PLANNING UTAMA
// =============================================

model Planning {
  id String @id @default(cuid())

  balaiId Int
  balai   Balai @relation(fields: [balaiId], references: [id])

  periodeId Int
  periode   Periode @relation(fields: [periodeId], references: [id])

  kodeProyek  String?    @unique @db.VarChar(50)
  projectName String     @db.Text
  kewenangan  Kewenangan @default(PUSAT)

  provinceId String? @db.VarChar(10)
  cityId     String? @db.VarChar(10)
  latitude   Float?
  longitude  Float?

  kebutuhanTanah   Boolean @default(false)
  sesuaiRTRW       String? @db.VarChar(50)
  nomorPerdaRTRW   String? @db.VarChar(100)
  sesuaiPolaSDA    String? @db.VarChar(50)
  nomorKepmenPUPR  String? @db.VarChar(100)
  sesuaiMasterplan String? @db.VarChar(255)
  polaRencana      String? @db.VarChar(100)

  // StudiLayak/DED/LARAP di DB.xlsx cuma angka tahun polos, tanpa status
  // terpisah — jadi field langsung, bukan lewat KriteriaDokumen generic
  // (dibuang, lihat docs-planning/audit-restrukturisasi-db-xlsx.md §3.3).
  tahunStudiLayak Int? @db.SmallInt
  tahunDed        Int? @db.SmallInt
  tahunLarap      Int? @db.SmallInt

  sumberUsulanProyek  SumberUsulanProyek?
  sumberUsulanLainnya String?             @db.Text

  status  PlanningStatus @default(DRAFT)
  catatan String?        @db.Text

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  paket Paket[]

  @@index([balaiId])
  @@index([status])
  @@index([createdById])
  @@index([periodeId])
  @@map("plannings")
}

// =============================================
// PAKET
// =============================================

model Paket {
  id         String   @id @default(cuid())
  planningId String
  planning   Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  kodePaket String? @unique @db.VarChar(50)
  name      String  @db.VarChar(255)

  roId String @db.VarChar(20)
  ro   RO     @relation(fields: [roId], references: [id])

  komponenId String?
  komponen   Komponen? @relation(fields: [komponenId], references: [id])

  jenis           JenisPaket
  masaPelaksanaan MasaPelaksanaan

  wilayahSungaiId String?
  wilayahSungai   WilayahSungai? @relation(fields: [wilayahSungaiId], references: [id])

  dokLingStatus String? @db.VarChar(50)

  catatanPembina String? @db.Text
  catatanSspsda  String? @db.Text

  // Indikator RENJA — dikonfirmasi lewat referensi 1.xlsx (lihat
  // docs-planning/fitur-paket/04-rekonsiliasi-referensi.md): PN/PP/KP,
  // SP/ISP, SK/ISK adalah hierarki master data, bukan teks bebas.
  kegiatanPrioritasId String?
  kegiatanPrioritas   KegiatanPrioritas? @relation(fields: [kegiatanPrioritasId], references: [id])

  pkpnId String?
  pkpn   Pkpn?   @relation(fields: [pkpnId], references: [id])

  indikatorSasaranProgramId String?
  indikatorSasaranProgram   IndikatorSasaranProgram? @relation(fields: [indikatorSasaranProgramId], references: [id])

  indikatorSasaranKegiatanId String?
  indikatorSasaranKegiatan   IndikatorSasaranKegiatan? @relation(fields: [indikatorSasaranKegiatanId], references: [id])

  indikatorRoId String?
  indikatorRo   IndikatorRO? @relation(fields: [indikatorRoId], references: [id])

  tematikRenjaId String?
  tematikRenja   TematikRenja? @relation(fields: [tematikRenjaId], references: [id])

  fkb Boolean @default(false)
  fkw Boolean @default(false)
  mpa Boolean @default(false)

  // Untuk ranking prioritas antar paket — algoritma penilaian menyusul,
  // sengaja nullable & tidak diisi lewat form dulu.
  score Decimal? @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  alokasi Alokasi[]

  @@index([planningId])
  @@index([roId])
  @@map("paket")
}

// =============================================
// ALOKASI
// =============================================

model Alokasi {
  id      String @id @default(cuid())
  paketId String
  paket   Paket  @relation(fields: [paketId], references: [id], onDelete: Cascade)

  tahun  Int            @db.SmallInt
  status AllokasiStatus

  rm    Decimal @default(0) @db.Decimal(16, 0)
  rmp   Decimal @default(0) @db.Decimal(16, 0)
  pln   Decimal @default(0) @db.Decimal(16, 0)
  sbsn  Decimal @default(0) @db.Decimal(16, 0)
  kpbu  Decimal @default(0) @db.Decimal(16, 0)
  total Decimal @default(0) @db.Decimal(16, 0)

  outputTarget  Decimal? @db.Decimal(10, 4)
  outputUnit    String?  @db.VarChar(50)
  outcomeTarget Decimal? @db.Decimal(10, 4)
  outcomeUnit   String?  @db.VarChar(50)

  catatan String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lokasi         LokasiAlokasi[]
  historiAlokasi HistoriAlokasi[]

  @@unique([paketId, tahun, status])
  @@index([tahun])
  @@map("alokasi")
}

model LokasiAlokasi {
  id        String  @id @default(cuid())
  alokasiId String
  alokasi   Alokasi @relation(fields: [alokasiId], references: [id], onDelete: Cascade)

  name          String?       @db.VarChar(255)
  tipeKoordinat TipeKoordinat @default(TITIK)

  // Wilayah administratif
  provinceId   String? @db.VarChar(10)
  provinceName String? @db.VarChar(100)
  cityId       String? @db.VarChar(10)
  cityName     String? @db.VarChar(100)
  districtId   String? @db.VarChar(10)
  districtName String? @db.VarChar(100)
  villageId    String? @db.VarChar(10)
  villageName  String? @db.VarChar(100)

  // Koordinat: untuk TITIK pakai latitude/longitude, untuk GARIS/POLIGON pakai coordinates (JSON array of [lat,lng])
  latitude    Float?
  longitude   Float?
  coordinates Json? // [[lat, lng], [lat, lng], ...] untuk garis/poligon

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lokasi_alokasi")
}

model HistoriAlokasi {
  id        String  @id @default(cuid())
  alokasiId String
  alokasi   Alokasi @relation(fields: [alokasiId], references: [id], onDelete: Cascade)

  rm            Decimal  @db.Decimal(16, 0)
  rmp           Decimal  @db.Decimal(16, 0)
  pln           Decimal  @db.Decimal(16, 0)
  sbsn          Decimal  @db.Decimal(16, 0)
  kpbu          Decimal  @db.Decimal(16, 0)
  total         Decimal  @db.Decimal(16, 0)
  outputTarget  Decimal? @db.Decimal(10, 4)
  outcomeTarget Decimal? @db.Decimal(10, 4)
  catatan       String?  @db.Text

  changedAt DateTime @default(now())
  changedBy String   @db.VarChar(150)

  @@map("histori_alokasi")
}
